# Convert all placeholder void boots

## CONSTRAINTS
#   AS player
#       If they have at least one ender pearl to convert

#====================================================================================================

execute if items entity @s weapon.offhand wind_charge run item modify entity @s weapon.offhand exigence:consumable_placeholder/wind_charge_to_placeholder

