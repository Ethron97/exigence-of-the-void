# Get item from sprite

## INPUT
#   STORAGE exigence:profile_icon sprite

## OUTPUT
#   STORAGE exigence:profile_icon item_output

#====================================================================================================

data modify storage exigence:profile_icon temp set value "minecraft:item/music_disc_tears"
scoreboard players set #temp Temp 0
execute store success score #temp Temp run data modify storage exigence:profile_icon temp set from storage exigence:profile_icon sprite
execute if score #temp Temp matches 0 run return run data modify storage exigence:profile_icon item_output set value "music_disc_tears"
